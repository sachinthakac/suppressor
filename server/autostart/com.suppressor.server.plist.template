<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd LaunchAgent for the Suppressor server (macOS).
     Installed by server/autostart/install.sh into ~/Library/LaunchAgents/;
     the @...@ placeholders are filled in there. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.suppressor.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>@PYTHON@</string>
        <string>-I</string>
        <string>server.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>@SERVER_DIR@</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>USE_TF</key>
        <string>0</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- don't respawn faster than this if it keeps exiting (e.g. port 8765 in use) -->
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>@LOG@</string>
    <key>StandardErrorPath</key>
    <string>@LOG@</string>
</dict>
</plist>
