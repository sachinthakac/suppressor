{
  "manifest_version": 3,
  "name": "Suppressor",
  "version": "0.1.0",
  "description": "Blurs spoilers (GTA VI for now) on YouTube and other sites using a local Laya classifier.",
  "browser_specific_settings": {
    "gecko": {
      "id": "suppressor@local",
      "strict_min_version": "121.0"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "*://*.youtube.com/*",
    "*://*.reddit.com/*",
    "*://x.com/*",
    "*://twitter.com/*"
  ],
  "background": {
    "scripts": ["topics.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.reddit.com/*", "*://x.com/*", "*://twitter.com/*"],
      "js": ["topics.js", "sites.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Suppressor",
    "default_popup": "popup.html"
  }
}
