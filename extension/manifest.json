{
  "manifest_version": 3,
  "name": "Suppressor",
  "version": "0.3.0",
  "description": "Blurs content about topics you choose (spoilers, leaks, gameplay...) using a local Laya classifier.",
  "browser_specific_settings": {
    "gecko": {
      "id": "suppressor@local",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.youtube.com/*",
    "*://*.reddit.com/*",
    "*://x.com/*",
    "*://twitter.com/*"
  ],
  "background": {
    "scripts": [
      "shared.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.reddit.com/*",
        "*://x.com/*",
        "*://twitter.com/*"
      ],
      "js": [
        "shared.js",
        "sites.js",
        "veil.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Suppressor",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
